# Obtain these values from your Supabase project's Connect dialog.
# Never commit .env.local or a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Set this to the deployed public URL when one exists. Local development defaults to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, server-only. Never prefix these with NEXT_PUBLIC or commit actual values.
# Required only for the implemented YouTube public-count refresh.
YOUTUBE_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
